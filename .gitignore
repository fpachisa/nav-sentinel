.DS_Store
# fixtures/data is committed deliberately. Every byte of the project's ground truth derives from
# recorded ECB rates, and a reviewer who cannot reach the network would otherwise get no books, no
# golden file and no closure proof. `make fixtures` regenerates it byte-identically offline.
.cache/
out/

# OAuth client files. The download contains a client *secret*, and this repository is public.
# Only the client id is ever needed here, and it is passed as an environment variable at deploy
# time rather than living in the tree.
client_secret_*.json
*.client_secret.json
