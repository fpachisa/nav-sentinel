# Copy to .env and fill in. See README.md > Spin-up.
GOOGLE_CLOUD_PROJECT=all-things-agentic-hack-fp
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# Model tiers (see src/nav_sentinel/config.py)
NAV_MODEL_REASONING=gemini-3.7-flash
NAV_MODEL_CLASSIFY=gemini-3.5-flash-lite

# Control plane
NAV_MODEL_ARMOR_TEMPLATE=nav-sentinel-untrusted-ingest
NAV_FIRESTORE_DATABASE=(default)
NAV_PUBSUB_TOPIC_EXCEPTIONS=nav-exceptions
NAV_ENABLE_TRACING=true

# SEC EDGAR requires a contact address in the User-Agent for automated access.
# Set this before running the corporate-actions investigator against live EDGAR.
NAV_SEC_CONTACT=
